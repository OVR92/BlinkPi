[Unit]
Description=Blink USB bridge — prune old clips from rclone destinations
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@PI_USER@
WorkingDirectory=@PROJECT_DIR@
Environment=BUB_CONFIG=@PROJECT_DIR@/config.yaml
ExecStart=@PROJECT_DIR@/.venv/bin/bub-prune
StandardOutput=journal
StandardError=journal

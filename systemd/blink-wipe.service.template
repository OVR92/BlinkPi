[Unit]
Description=Blink USB bridge — nightly cleanup of backing image
After=blink-gadget.service

[Service]
Type=oneshot
User=root
WorkingDirectory=@PROJECT_DIR@
Environment=BUB_CONFIG=@PROJECT_DIR@/config.yaml
ExecStart=@PROJECT_DIR@/.venv/bin/bub-wipe
StandardOutput=journal
StandardError=journal
